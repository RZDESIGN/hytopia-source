{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "nodemon -q --watch src --ext ts,json --ignore src/playground.mjs -x \"npm run build:playground && node src/playground.mjs\"",
    "build": "npm run build:server && npm run build:declaration && npm run build:protocol && npm run build:api && npm run build:docs",
    "build:playground": "bun build src/playground.ts --minify --legal-comments=inline --target=node --format=esm --sourcemap=none --outfile=./src/playground.mjs --env=disable --external=@fails-components/webtransport --external=@fails-components/webtransport-transport-http3-quiche",
    "build:server": "bun build src/index.ts --minify --legal-comments=inline --target=node --format=esm --sourcemap=none --outfile=../sdk/server.mjs --env=disable --external=@fails-components/webtransport --external=@fails-components/webtransport-transport-http3-quiche",
    "build:declaration": "tsc --emitDeclarationOnly --project tsconfig.json && tsc-alias",
    "build:protocol": "tsc --project ../protocol/tsconfig.json",
    "build:docs": "npx api-documenter markdown --input-folder=../sdk --output-folder ../sdk/docs",
    "build:api": "npx api-extractor run --local",
    "format": "npx eslint --fix ./src",
    "test:world-host-all": "npm run test:world-host && npm run test:world-host-client",
    "test:world-host": "node --test ./tests/worlds/hosting/*.test.mjs",
    "test:world-host-client": "bun test ./tests/worlds/hosting/*.test.ts"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@microsoft/api-documenter": "^7.29.7",
    "@microsoft/api-extractor": "^7.57.7",
    "@types/express": "^5.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-tsdoc": "^0.5.2",
    "jsdoc": "^4.0.4",
    "nodemon": "^3.1.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.13.0"
  },
  "peerDependencies": {
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "0.19.3",
    "@fails-components/webtransport": "1.5.3",
    "@fails-components/webtransport-transport-http3-quiche": "1.5.3",
    "@gltf-transform/core": "4.3.0",
    "@gltf-transform/extensions": "4.3.0",
    "@gltf-transform/functions": "4.3.0",
    "@hytopia.com/creative-lib": "^0.0.19",
    "@hytopia.com/save-states": "^0.0.15",
    "@hytopia.com/server-protocol": "file:../protocol",
    "@sentry/node": "9.22.0",
    "ajv": "8.18.0",
    "eventemitter3": "^5.0.4",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "gl-matrix": "^3.4.4",
    "glob": "11.1.0",
    "graphql-ws": "^6.0.7",
    "heap-js": "^2.7.1",
    "jimp": "^1.6.0",
    "msgpackr": "^1.11.8",
    "undici": "^7.16.0",
    "uuid": "10.0.0",
    "ws": "^8.19.0"
  },
  "trustedDependencies": [
    "sharp"
  ],
  "overrides": {
    "minimatch": "^10.2.4"
  }
}
