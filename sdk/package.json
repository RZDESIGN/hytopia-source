{
  "name": "hammy-hytopia",
  "version": "0.15.5",
  "description": "Hammy fork of the HYTOPIA SDK - create massively multiplayer games using JavaScript or TypeScript. Uses custom client at hammyhytopia.com.",
  "type": "module",
  "main": "./server.mjs",
  "exports": {
    ".": {
      "types": "./server.d.ts",
      "default": "./server.mjs"
    }
  },
  "bin": {
    "hytopia": "bin/scripts.js",
    "hammy-hytopia": "bin/scripts.js",
    "hammy": "bin/scripts.js"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "keywords": [
    "hytopia",
    "hammy",
    "multiplayer",
    "games",
    "game",
    "sdk",
    "voxel",
    "game-engine",
    "game-server",
    "multiplayer-game"
  ],
  "author": "Hammy (fork of HYTOPIA, Inc.)",
  "license": "SEE LICENSE IN LICENSE.md",
  "types": "./server.d.ts",
  "bugs": {
    "url": "https://github.com/hytopiagg/sdk/issues"
  },
  "homepage": "https://github.com/hytopiagg/sdk#readme",
  "dependencies": {
    "@fails-components/webtransport": "^1.5.3",
    "@fails-components/webtransport-transport-http3-quiche": "^1.5.3",
    "@gltf-transform/cli": "^4.3.0",
    "archiver": "7.0.1",
    "bun": "^1.3.10",
    "nodemon": "^3.1.14",
    "ws": "^8.19.0"
  },
  "scripts": {
    "prepublishOnly": "node ./bin/writeVersion.js"
  }
}
